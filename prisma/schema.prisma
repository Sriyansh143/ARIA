// ARIA Mission Control — hardened production schema (v28.0-hermes-autonomous)
// Dual-database: SQLite for dev, PostgreSQL for production.
// The provider is selected at runtime by src/lib/db.ts based on DATABASE_URL:
//   - file:./... or file:/... → sqlite
//   - postgresql://...       → postgresql
// All field types are compatible with both providers (no JSON column type,
// no native arrays — everything is String with JSON.stringify at the app layer).
//
// String fields carry doc-comments enumerating the allowed union values;
// runtime contracts are enforced via zod in src/lib/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // This is the dev default. In production, src/lib/db.ts dynamically
  // selects postgresql when DATABASE_URL starts with "postgresql://".
  // For prisma CLI commands (db:push, migrate), set DATABASE_URL in .env
  // to the target database — the CLI reads this provider value.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Autonomy Tags (Notion "AI Company Map" integration, v59) ─────────
// Every workflow + skill carries an autonomyTag that the conductor-router
// enforces BEFORE execution:
//   HUMAN_LED          → never runs without owner triggering it
//   HUMAN_ASSISTED     → routes to the Telegram approval queue before exec
//   FULLY_AUTONOMOUS   → runs without human gating (cron + supervisor only)
enum AutonomyTag {
  HUMAN_LED
  HUMAN_ASSISTED
  FULLY_AUTONOMOUS
}

// ─── Agents ──────────────────────────────────────────────────────────
model Agent {
  id           String   @id @default(cuid())
  name         String   @unique
  role         String // CEO | COO | CFO | CTO | Engineering | DevOps | QA | Architect | Research | DataAnalyst | DataScientist | Ops | ProjectManager | Compliance | Finance | Accountant | PaymentsProcessor | Sales | SalesDevelopment | AccountExecutive | CRM | Support | SuccessManager | Marketer | SocialMedia | ContentCreator | AdCreative | LegalAnalyst | Ethicist | CommsAgent | EmailWorker | VoiceAgent | CommunityManager | Linguist | ClientOnboarding | ClientSuccess | Conductor
  tier         String   @default("balanced") // strong | balanced | fast
  status       String   @default("idle") // idle | thinking | executing | streaming | waiting | error | offline
  model        String?
  department   String?
  capabilities String   @default("[]") // JSON array of capability strings
  currentTask  String?
  tokensUsed   Int      @default(0)
  tasksDone    Int      @default(0)
  errorCount   Int      @default(0)
  lastBeatAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks        Task[]
  logs         AgentLog[]
  metrics      MetricPoint[]

  @@index([status])
  @@index([department])
  @@index([role])
}

// ─── Tasks ───────────────────────────────────────────────────────────
model Task {
  id           String   @id @default(cuid())
  title        String
  description  String?
  status       String   @default("pending") // pending | running | completed | failed | blocked
  priority     String   @default("medium") // low | medium | high | critical
  assignedToId String?
  dependsOn    String   @default("[]") // JSON array of task ids (DAG)
  result       String?
  progress     Int      @default(0) // 0-100
  kind         String   @default("work") // work | tool_call | research | review | decision
  createdAt    DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  updatedAt    DateTime @updatedAt

  assignedTo   Agent?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  logs         AgentLog[]

  @@index([status])
  @@index([assignedToId])
  @@index([priority])
}

// ─── Agent Logs ──────────────────────────────────────────────────────
model AgentLog {
  id        String   @id @default(cuid())
  agentId   String?
  taskId    String?
  level     String   @default("info") // debug | info | warn | error | success
  message   String
  meta      String? // JSON blob
  createdAt DateTime @default(now())

  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([taskId])
  @@index([createdAt])
  @@index([level])
}

// ─── Events (SSE backbone) ───────────────────────────────────────────
model Event {
  id        String   @id @default(cuid())
  type      String // agent.status | task.update | log | metric | approval | llm | system | alert
  channel   String   @default("global")
  payload   String // JSON blob
  createdAt DateTime @default(now())

  @@index([type])
  @@index([channel])
  @@index([createdAt])
}

// ─── Metrics ─────────────────────────────────────────────────────────
model MetricPoint {
  id        String   @id @default(cuid())
  agentId   String?
  name      String // tokens | latency_ms | tasks_done | revenue | errors | throughput
  value     Float
  unit      String?
  createdAt DateTime @default(now())

  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([name])
  @@index([createdAt])
}

// ─── Approvals (autonomous approval gate) ────────────────────────────
// Enhanced (Task 23): every approval carries an LLM-generated owner brief
// (why/risks/ifApproved/ifNotApproved/clarifications) plus a discussion log
// so the owner can ask questions before deciding. Oral confirmation via
// voice call is supported — `oralConfirmed` flips to true when a transcript
// is analyzed and an affirmative phrase is found; the PATCH handler then
// auto-approves without a button press.
model Approval {
  id        String   @id @default(cuid())
  title     String
  summary   String?
  risk      String   @default("medium") // low | medium | high | critical
  status    String   @default("pending") // pending | approved | denied | expired
  requester String?
  agentId   String?
  action    String? // e.g. deploy | spend | send_email | sign_contract
  amount    Float?
  payload   String? // JSON action payload
  // ── Owner brief (Task 23) ──
  // JSON blob: { why, risks: string[], ifApproved, ifNotApproved, clarifications: { q, a }[] }
  // Generated by src/lib/approval-brief.ts:generateApprovalBrief().
  brief          String?
  // JSON array of { role: "owner"|"agent"|"system", message, timestamp } —
  // the conversation history between owner and the approval-discussion LLM.
  discussionLog   String?
  // True if the owner orally approved via a voice-call transcript
  // (src/lib/approval-brief.ts:oralConfirm()).
  oralConfirmed   Boolean  @default(false)
  // Linked voice call record (free-form string; future VoiceCall model id).
  voiceCallId     String?
  // v61 Phase 2 (Owner Rule: 2-Hour Deferral) — when set, the approval has
  // been deferred (owner hasn't responded in 2h). The system pivots agents
  // to other work + sends reminders. Cleared when the owner decides.
  deferredUntil    DateTime?
  createdAt DateTime @default(now())
  decidedAt DateTime?

  @@index([status])
  @@index([risk])
  @@index([oralConfirmed])
  @@index([deferredUntil])
}

// ─── Cron Jobs (background daemon registry) ──────────────────────────
model CronJob {
  id          String   @id @default(cuid())
  name        String   @unique
  schedule    String // cron expression or interval label
  description String?
  status      String   @default("active") // active | paused | error
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastResult  String?
  runCount    Int      @default(0)
  failCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// ─── Cron Run History ────────────────────────────────────────────────
model CronRun {
  id        String   @id @default(cuid())
  cronJobId String
  jobName   String
  ok        Boolean
  result    String?
  latencyMs Int      @default(0)
  createdAt DateTime @default(now())

  @@index([cronJobId])
  @@index([createdAt])
  @@index([ok])
}

// ─── LLM Calls (gateway audit log) ───────────────────────────────────
model LlmCall {
  id         String   @id @default(cuid())
  agentId    String?                    // owning agent (nullable for system/Conductor calls)
  provider   String // zai | ollama | openai | anthropic | gemini | groq | deepseek
  model      String
  prompt     String
  completion String?
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  latencyMs  Int      @default(0)
  status     String   @default("ok") // ok | rate_limited | error | fallback
  fallback   Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())

  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@index([agentId])
}

// ─── System Alerts ───────────────────────────────────────────────────
model SystemAlert {
  id        String   @id @default(cuid())
  severity  String // info | warn | error | critical
  source    String // llm | cron | agent | healer | system
  message   String
  ack       Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([severity])
  @@index([ack])
  @@index([createdAt])
}

// ─── Skills Registry ─────────────────────────────────────────────────
// Hermes core engine: progressive-disclosure skills. Lightweight rows
// carry only name/description for the system prompt; `instructions` +
// `script` are lazy-loaded only when a skill is actually invoked.
model Skill {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  category     String // llm | media | doc | data | web
  description  String?
  instructions String? // full prompt instructions (progressive disclosure — only loaded on invoke)
  script       String? // executable script template (for createSkillFromExecution)
  source       String   @default("builtin") // builtin | community | custom | learned
  status       String   @default("active") // active | deprecated | disabled
  // v59 (Notion "AI Company Map" Autonomy Tags): the conductor-router enforces
  // this before invoking the skill. HUMAN_ASSISTED → Telegram approval queue.
  autonomyTag  AutonomyTag @default(HUMAN_ASSISTED)
  invocations  Int      @default(0)
  successRate  Float    @default(1.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([source])
  @@index([autonomyTag])
}

// ─── Workflow Definitions (v59 — persisted workflows + autonomy tags) ──
// The in-memory `Workflow` interface in src/lib/workflow-engine.ts is the
// execution shape; this model persists workflow templates so the conductor
// can look up autonomy policy + approval state across restarts. The
// conductor-router (src/lib/conductor/router.ts) reads `autonomyTag` before
// dispatch: HUMAN_ASSISTED workflows are blocked + routed to the Telegram
// approval queue; FULLY_AUTONOMOUS workflows run directly.
model WorkflowDefinition {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  description  String?
  // JSON-serialized WorkflowStep[] (the in-memory interface from workflow-engine.ts).
  stepsJson    String
  trigger      String       @default("manual") // manual | schedule | event | approval
  status       String       @default("draft")  // draft | active | running | completed | failed
  // v59 (Notion "AI Company Map" Autonomy Tags):
  autonomyTag  AutonomyTag  @default(HUMAN_ASSISTED)
  // If autonomyTag = HUMAN_ASSISTED, the conductor creates an Approval row +
  // sends a Telegram brief. When the owner approves, the workflow runs.
  pendingApprovalId String? // FK to Approval.id (nullable when autonomous or already approved)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([autonomyTag])
  @@index([status])
  @@index([trigger])
}

// ─── Sub-Agent Tasks (agent-to-agent delegation) ─────────────────────
// When an agent uses the spawn_subagent tool, a SubAgentTask row records
// the parent→child delegation, status, and result. Mirrors Hermes'
// orchestration graph so the conductor can audit delegation chains.
model SubAgentTask {
  id           String    @id @default(cuid())
  parentId     String                      // delegating (parent) agent id
  childAgentId String?                     // assigned sub-agent (nullable if not yet picked up)
  task         String                      // natural-language task description
  status       String    @default("pending") // pending | running | completed | failed | cancelled
  result       String?                     // JSON blob — final result payload
  summary      String?                     // human-readable summary
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([parentId])
  @@index([childAgentId])
  @@index([status])
  @@index([createdAt])
}

// ─── Earning Opportunities (autonomous income pipeline) ─────────────
// Revenue opportunities discovered by autonomous agents (scans, outreach,
// inbound, referrals). Tracked from discovery through qualification,
// pipeline, execution, and closure. Linked to a Deal once qualified.
model EarningOpportunity {
  id                    String   @id @default(cuid())
  title                 String
  description           String?
  source                String // autonomous-scan | outreach | inbound | referral | partnership | marketplace
  estimatedRevenue      Float   @default(0)
  timeToExecuteHours    Float   @default(0)
  department            String // Sales | Engineering | Marketing | Support | etc.
  feasibilityScore      Float   @default(0.5) // 0-1 — agent's estimated likelihood of success
  status                String   @default("discovered") // discovered | qualified | pipeline | executing | closed
  dealId                String? // linked Deal (once qualified → pipeline)
  taskId                String? // linked Task (if execution is in-flight)
  discoveredAt          DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([department])
  @@index([discoveredAt])
}

// ─── Learned Insights (autonomous daily learning pipeline) ──────────
// Output of the multimodal learning engine — one row per ingested
// insight from videos, social feeds, or web URLs. Linked to the
// MemoryItem (if stored as knowledge) and Skill (if actionable).
model LearnedInsight {
  id            String   @id @default(cuid())
  source        String // original URL or platform handle
  sourceType    String // video | social | web
  content       String // the raw extracted content / transcript slice
  insights      String // JSON array of insight strings
  memoryItemId  String? // linked MemoryItem (if stored as knowledge)
  skillId       String? // linked Skill (if insight was turned into a skill)
  agentId       String? // owning agent
  createdAt     DateTime @default(now())

  @@index([sourceType])
  @@index([agentId])
  @@index([createdAt])
}

// ─── Revenue Events (autonomous income tracking) ────────────────────
model RevenueEvent {
  id          String   @id @default(cuid())
  source      String                     // subscription | services | api_usage | affiliate | marketplace
  amount      Float
  currency    String   @default("USD")
  agentId     String?                    // which agent closed it
  dealId      String?                    // linked deal (optional)
  description String?
  createdAt   DateTime @default(now())

  @@index([source])
  @@index([createdAt])
  @@index([agentId])
}

// ─── Deals (pipeline: lead → won/lost) ──────────────────────────────
model Deal {
  id           String   @id @default(cuid())
  title        String
  value        Float   @default(0)
  currency     String   @default("USD")
  stage        String   @default("lead") // lead | qualified | proposal | negotiation | won | lost
  probability  Int      @default(20)     // 0-100 win probability
  source       String   @default("autonomous-scan") // autonomous-scan | outreach | inbound | referral
  agentId      String?                    // owning agent
  counterparty String?                    // client/company name
  expectedClose DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([stage])
  @@index([source])
  @@index([agentId])
}

// ─── Agent Messages (inter-agent communication log) ─────────────────
model AgentMessage {
  id          String   @id @default(cuid())
  fromAgentId String?
  toAgentId   String?
  channel     String   @default("task")  // task | approval | alert | coordination | broadcast
  messageType String                     // request | response | delegate | inform | escalate
  subject     String
  body        String?
  taskId      String?
  createdAt   DateTime @default(now())

  @@index([fromAgentId])
  @@index([toAgentId])
  @@index([createdAt])
  @@index([channel])
}

// ─── Memory Items (connected knowledge graph) ───────────────────────
model MemoryItem {
  id          String   @id @default(cuid())
  key         String   @unique
  scope       String   @default("general") // config | branding | agent | system | strategy | knowledge | failure | success | optimization
  value       String                       // JSON blob
  tags        String   @default("[]")      // JSON array of tags
  pinned      Boolean  @default(false)
  linkedTo    String   @default("[]")      // JSON array of memory IDs (graph edges)
  strength    Float    @default(0.5)       // 0-1 connection strength
  agentId     String?                      // which agent created/owns this
  // v61.4 Phase 9 (REAL Vector Memory): 768-dim embedding from nomic-embed-text,
  // stored as JSON array. Used by vector-memory.ts for cosine similarity search.
  // Null when Ollama is unavailable (keyword-searchable only).
  embeddingJson String?                    // JSON array of 768 floats (nomic-embed-text)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope])
  @@index([pinned])
  @@index([agentId])
}

// ─── Users (auth + ownership) ────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  role          String    @default("owner") // owner | admin | viewer
  emailVerified DateTime?
  // ── 2FA (v40: enforced at login) ──
  twoFactorSecret       String?  // base32-encoded TOTP secret
  twoFactorEnabled      Boolean  @default(false)
  twoFactorBackupCodes  String   @default("[]") // JSON array of bcrypt-hashed one-time codes
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  @@index([email])
}

// ─── OAuth Accounts (NextAuth adapter) ───────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ─── Sessions (NextAuth adapter) ─────────────────────────────────────
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Verification Tokens (NextAuth adapter) ──────────────────────────
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Personnel (human staff alongside agents) ───────────────────────
// Mirrors the FounderOS human roster (Marco, Nadia, Mia). Each row is
// a real person with their toolbelt — `tools` is a JSON array of tool
// slugs the human is proficient with. `departmentId` matches the same
// Department union used by agents (e.g. "Sales", "Marketing",
// "Communications") so humans + agents cluster together in the network
// graph.
model Personnel {
  id           String   @id @default(cuid())
  name         String
  role         String  // e.g. "Head of Sales", "Executive Assistant"
  departmentId String  // FK-equivalent to Department union (string for SQLite)
  tools        String   @default("[]")  // JSON array of tool names
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([departmentId])
}

// ─── Hermes: SubAgent Tasks (subagent delegation protocol) ─────────

// ─── Company Profiles (multi-company under one ARIA account) ────────
// Task 23 — Multi-company support. An ARIA master account (`parentAccountId`)
// can own multiple CompanyProfile rows, each representing an independent
// company the autonomous fleet operates. Only `isActive=true` companies
// are surfaced in the switcher; deactivating is soft-delete.
model CompanyProfile {
  id              String   @id @default(cuid())
  name            String
  tagline         String?
  industry        String?
  website         String?
  email           String?
  currency        String   @default("USD")
  timezone        String   @default("UTC")
  // The ARIA master account that owns this company. NULL = standalone
  // (single-company accounts preserve prior behavior). Multiple rows
  // sharing the same parentAccountId form a multi-company fleet.
  parentAccountId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([parentAccountId])
  @@index([isActive])
}

// ─── Company ↔ Earning-Opportunity assignments ──────────────────────
// Many-to-many join: an EarningOpportunity discovered by an agent can be
// assigned to one or more companies (e.g. an enterprise SaaS deal that
// applies to two of the owner's brands). Lightweight link table — no
// relation constraints (Prisma SQLite FKs are advisory) but indexed
// both ways for fast lookups.
model CompanyEarningOpportunity {
  id            String   @id @default(cuid())
  companyId     String
  opportunityId String
  assignedAt    DateTime @default(now())

  @@index([companyId])
  @@index([opportunityId])
}

// ─── Simulation Runs (100x Simulator with result injection) ────────
// Task 24 — Each SimulationRun records one full N-iteration Monte-Carlo
// pass over a scenario (product-launch, client-call, etc.). The best +
// worst previous iterations are injected into each subsequent run as
// context, so the LLM "learns" from its prior attempts within a single
// run. Best/worst scores + the JSON-encoded results array make the run
// fully replayable from the DB alone.
model SimulationRun {
  id              String   @id @default(cuid())
  scenario        String                          // "product-launch" | "client-call" | "investor-meeting" | "marketing-campaign" | "owner-meeting"
  title           String
  description     String
  iterations      Int      @default(100)
  completedIters  Int      @default(0)
  status          String   @default("pending")   // pending | running | completed | failed
  inputs          String   @default("{}")        // JSON: initial scenario inputs
  bestScore       Float    @default(0)
  bestResult      String?                          // JSON: the best iteration's result
  worstScore      Float    @default(1)
  results         String   @default("[]")        // JSON array of all iteration results
  improvementNotes String  @default("[]")        // JSON array of notes from previous runs injected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scenario])
  @@index([status])
}

// ─── Simulation Iterations (per-iteration result records) ──────────
// One row per iteration within a SimulationRun. Carries the score,
// outcome description, analysis (what went well/wrong), and the
// improvement notes the LLM generated for the NEXT iteration. Indexed
// on (simulationRunId, iteration) for fast replay + injection queries.
model SimulationIteration {
  id              String   @id @default(cuid())
  simulationRunId String
  iteration       Int
  score           Float                          // 0-1
  outcome         String                          // description of what happened
  analysis        String                          // what went well / wrong
  improvements    String?                         // suggestions for next iteration
  createdAt       DateTime @default(now())

  @@index([simulationRunId])
  @@index([iteration])
}

// ════════════════════════════════════════════════════════════════════
// v25.9.7 MERGED CAPABILITIES — ported from aria-mission-control-v25.9.7-final
// These models extend the v28 Hermes-native base with the autonomous
// revenue, security, system-access, and intelligence layers without
// breaking any existing route or type definition.
// ════════════════════════════════════════════════════════════════════

// ─── Credential Vault (AES-256-GCM encrypted platform credentials) ──
model Credential {
  id          String   @id @default(cuid())
  key         String   @unique                       // e.g. "openai_api_key"
  label       String                                  // human label
  category    String   @default("llm")               // llm | payment | crm | email | telephony | custom
  ciphertext  String                                  // AES-256-GCM base64
  iv          String                                  // initialization vector base64
  authTag     String                                  // GCM auth tag base64
  metadata    String   @default("{}")                // JSON: { masked, hint, rotationDue }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([category])
}

// ─── System Access Layer (thermal-guarded real system access) ──────
model SystemAccessSession {
  id          String   @id @default(cuid())
  agentId     String?
  requester   String                                   // agent name or "owner"
  scope       String                                   // shell | browser | filesystem | computer-use
  reason      String
  status      String   @default("pending")             // pending | approved | denied | expired | revoked
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  @@index([status])
  @@index([agentId])
}

model SystemAccessApproval {
  id          String   @id @default(cuid())
  sessionId   String
  decision    String                                   // approve | deny
  decider     String                                   // "owner" | monitoring-agent name
  rationale   String   @default("")
  createdAt   DateTime @default(now())
  @@index([sessionId])
}

model SystemAccessAction {
  id          String   @id @default(cuid())
  sessionId   String
  action      String                                   // e.g. "shell:ls -la", "browser:click", "fs:read"
  result      String   @default("{}")                  // JSON result payload
  ok          Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@index([sessionId])
}

// ─── Notes (owner + agent scratchpad) ───────────────────────────────
model Note {
  id          String   @id @default(cuid())
  title       String
  body        String   @default("")
  tags        String   @default("[]")                  // JSON array
  pinned      Boolean  @default(false)
  authorAgent String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([pinned])
}

// ─── Milestone Events (animated celebration overlay) ───────────────
model MilestoneEvent {
  id          String   @id @default(cuid())
