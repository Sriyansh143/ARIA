  comments        Int      @default(0)
  shares          Int      @default(0)
  reach           Int      @default(0)
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([platform])
  @@index([postType])
  @@index([approvalStatus])
  @@index([approvedPatternId])
}

model ApprovedPattern {
  id              String   @id @default(cuid())
  // The pattern
  patternName     String   // human-readable name
  channel         String   // instagram | facebook | x | linkedin | whatsapp-blast | email-blast | call
  category        String   // e.g. "free-offer-100", "no-website-outreach", "imported-contact-blast"
  // Content (the approved template — variables use {{var}} placeholders)
  contentTemplate String   // the post text, message body, or call script template
  variablesJson   String   @default("[]") // list of placeholder variable names: ["businessName", "city", ...]
  targetAudienceDescription String @default("")
  // Approval
  status          String   @default("pending") // pending | approved | rejected | revoked | expired
  approvedAt      DateTime?
  approvedBy      String   @default("")
  expiresAt       DateTime? // max 30 days after approval
  revokedAt       DateTime?
  revokeReason   String   @default("")
  // Usage tracking
  usageCount      Int      @default(0) // how many times this pattern has been used
  maxUsage        Int      @default(1000) // safety cap
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([channel])
  @@index([category])
  @@index([status])
}

model CallScript {
  id              String   @id @default(cuid())
  // The script
  scriptName      String
  category        String   // e.g. "no-website-outreach-call", "free-offer-call"
  targetAudience  String   @default("")
  // Content (the call script — what the AI voice agent will say)
  openingHook     String   // first 5 seconds (RULE-56: no "I am an AI")
  pitchBody       String   // main pitch
  objectionHandlersJson String @default("[]") // array of {objection, response}
  closingQuestion String   // e.g. "Can I send you a free preview?"
  // Approval (RULE-71: per-category pattern approval)
  approvedPatternId String?
  approvalStatus  String   @default("pending") // pending | approved | rejected
  approvedAt      DateTime?
  // Usage
  usageCount      Int      @default(0)
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([approvalStatus])
}

// v73 Phase 23 (RULE-72, 73, 74): Real-World MNC Operations
// New models: RefactorProposal (self-evolution), Contract (legal), LedgerEntry (CFO),
// ClientPortalAccess (client portal), BrowserSession (computer-use-accounts).

model RefactorProposal {
  id              String   @id @default(cuid())
  // The failing module
  targetFile      String   // e.g. "src/lib/whatsapp/business.ts"
  failureRate     Float    @default(0) // 7-day failure rate %
  failureCount    Int      @default(0)
  // The detection
  reason          String   // e.g. "Baileys timeout on connect — 18 failures in 7d"
  errorSamplesJson String  @default("[]") // top 5 error messages from AgentLog
  techDebtDeadline DateTime? // if a // TECH-DEBT deadline passed, this is set
  // The proposed fix
  originalCode    String   @default("") // current file contents at proposal time
  proposedCode    String   @default("") // the new draft
  // Sandbox test results
  testResults     String   @default("{}") // JSON: { pass, fail, output }
  buildSucceeded  Boolean  @default(false)
  // Approval + execution
  status          String   @default("pending") // pending | approved | rejected | merged | failed
  approvedAt      DateTime?
  approvedBy      String   @default("")
  mergedAt        DateTime?
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([targetFile])
  @@index([createdAt])
}

model Contract {
  id              String   @id @default(cuid())
  // Contract metadata
  contractType    String   @default("SOW") // SOW | MSA | NDA | addendum
  contractNumber  String   @unique // e.g. ARIA-SOW-2026-001
  // Parties
  clientName      String
  clientEmail     String
  clientCompany   String   @default("")
  // Service details
  serviceName     String
  serviceDescription String  @default("")
  amountCents     Int      @default(0) // total contract value in cents
  currency        String   @default("USD")
  milestonesJson  String   @default("[]") // [{name, deliverable, dueDate, amountCents}]
  // The PDF
  pdfUrl          String   @default("") // path to generated PDF
  pdfBase64       String   @default("") // base64-encoded PDF (for email attachment)
  // E-Signature flow
  status          String   @default("draft") // draft | sent | signed | expired | rejected
  sentAt          DateTime?
  signedAt       DateTime?
  signedByEmail   String   @default("")
  signedByIp      String   @default("")
  signaturePhrase String   @default("I AGREE TO THE TERMS") // the phrase the client must reply
  // ─── Phase 30 — E-Signature Provider Integration ──────────────────
  // When a contract is sent via DocuSign/HelloSign, the envelopeId is the
  // provider's reference for tracking the signature lifecycle. The webhook
  // at /api/webhooks/esign uses this id to match inbound events.
  esignProvider   String   @default("") // "" | "docusign" | "hellosign" | "mock"
  envelopeId      String   @default("") // provider's envelope ID (empty for email-reply signing)
  esignStatus     String   @default("") // "" | "sent" | "delivered" | "completed" | "declined" | "voided"
  esignSignedAt   DateTime? // when the provider confirmed signature
  esignEventsJson String   @default("[]") // JSON array of webhook events received
  // ─── Phase 30 — Tax Calculation ───────────────────────────────────
  // Pre-tax amount in cents. amountCents = subtotalCents + taxAmountCents.
  subtotalCents   Int      @default(0)
  taxAmountCents  Int      @default(0) // calculated by Stripe Tax or 0 if tax not applicable
  taxRate         Float    @default(0) // e.g. 0.0825 = 8.25%
  taxJurisdiction String   @default("") // e.g. "US-CA" | "EU-DE" | "IN-MH"
  // Linkage
  serviceOrderId  String?  // FK to ServiceOrder.id (set when contract is signed → triggers fulfillment)
  leadId          String?  // FK to Lead.id (the lead that became this contract)
  // Audit
  createdAt       DateTime @default(now())
  expiresAt      DateTime? // contracts expire after 30 days if not signed
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([clientEmail])
  @@index([serviceOrderId])
  @@index([createdAt])
  @@index([envelopeId])
  @@index([esignProvider])
}

model LedgerEntry {
  id              String   @id @default(cuid())
  // Double-entry bookkeeping
  entryDate       DateTime @default(now())
  account         String   // Revenue | Cash | API Expense | Compute Expense | Contractor Expense | OpEx
  subAccount      String   @default("") // e.g. "Revenue:SaaS-Scaffold", "API Expense:Z-AI"
  debitCents     Int      @default(0) // what comes IN
  creditCents    Int      @default(0) // what goes OUT
  description     String   @default("") // human-readable
  referenceType   String   @default("") // stripe-payment | api-call | ollama-compute | contractor-payout | manual
  referenceId     String   @default("") // FK to the source record (Stripe ID, AgentLog ID, etc.)
  // Audit
  createdAt       DateTime @default(now())

  @@index([account])
  @@index([subAccount])
  @@index([entryDate])
  @@index([referenceType])
  @@index([referenceId])
}

model ClientPortalAccess {
  id              String   @id @default(cuid())
  // The magic-link token
  token           String   @unique
  // The client
  clientName      String
  clientEmail     String
  clientCompany   String   @default("")
  // Linkage
  serviceOrderId  String?  // FK to ServiceOrder.id
  contractId      String?  // FK to Contract.id
  // Access control
  expiresAt      DateTime?
  lastAccessedAt DateTime?
  accessCount    Int      @default(0)
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientEmail])
  @@index([serviceOrderId])
  @@index([expiresAt])
}

model BrowserSession {
  id              String   @id @default(cuid())
  // The platform + identity
  platform        String   @unique // instagram | linkedin | gmail | facebook | x
  accountHandle   String   @default("") // e.g. "@aria_ai_company"
  // The session
  sessionDir      String   @default("") // path to the persistent browser session (cookies, localStorage)
  userDataDir     String   @default("") // Playwright userDataDir for persistent login
  // State
  isConnected    Boolean  @default(false)
  lastLoginAt    DateTime?
  lastActivityAt DateTime?
  // Credentials (stored in Credential Vault, referenced by key)
  credentialVaultKey String @default("")
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// v74 Phase 24 (RULE-75, 76, 77, 78, 79): Enterprise Platform
// New models: CodeArchive (refactor rollback), ComplianceFinding (audit results),
// CapabilityManifest (live capability registry), OwnerWorkspace (multi-tenant).

model CodeArchive {
  id              String   @id @default(cuid())
  // The archived file
  targetFile      String   // e.g. "src/lib/whatsapp/business.ts"
  originalCode    String   // the OLD code before refactor
  proposedCode    String   // the proposed replacement (for diff)
  // Linkage
  refactorProposalId String? // FK to RefactorProposal.id
  // Audit
  archivedAt      DateTime @default(now())
  restoredAt      DateTime? // set when this archive was restored (rollback)

  @@index([targetFile])
  @@index([archivedAt])
}

model ComplianceFinding {
  id              String   @id @default(cuid())
  ruleId          String   // e.g. "RULE-51-PRE-PUBLISH-QUALITY-GATE"
  ruleName        String
  status          String   @default("pass") // pass | fail | warning
  evidence        String   // file:line reference or "NOT IMPLEMENTED"
  checkType        String   @default("static-grep") // static-grep | runtime-log | manual
  notes           String   @default("")
  // Audit
  checkedAt       DateTime @default(now())

  @@index([ruleId])
  @@index([status])
  @@index([checkedAt])
}

model CapabilityManifest {
  id              String   @id @default(cuid())
  // The manifest
  manifestJson    String   // full JSON of all capabilities
  apiCount        Int      @default(0)
  moduleCount     Int      @default(0)
  cronCount       Int      @default(0)
  ruleCount       Int      @default(0)
  // Audit
  generatedAt     DateTime @default(now())
  version         String   @default("v74")

  @@index([generatedAt])
}

model OwnerWorkspace {
  id              String   @id @default(cuid())
  ownerId         String   @unique // e.g. "default" | "franchisee-001" | "owner-abc123"
  // The owner's isolated env + DB
  envFilePath     String   @default("") // path to .env.owner_[id]
  dbPath          String   @default("") // path to prisma/workspaces/owner_[id].db
  // Identity
  displayName     String   @default("")
  telegramBotToken String  @default("") // identifies which owner a Telegram message belongs to
  // Audit
  createdAt       DateTime @default(now())
  lastActiveAt    DateTime?
  updatedAt       DateTime @updatedAt

  @@index([ownerId])
}

// ─── Phase 29 — Telegram-First Owner Approval ────────────────────────
// Stores the threaded conversation (questions + suggestions) between owner
// and the agent for a single approval. Triggered by the "Ask Question" and
// "Suggest Improvement" inline buttons on Telegram approval messages.
// Each row lives until the approval is decided (approved/denied/expired),
// then status flips to "resolved".
model ApprovalConversation {
  id            String   @id @default(cuid())
  approvalId    String   // FK → Approval.id (logical, not enforced)
  // JSON array of messages: { role: "owner"|"agent"|"system", content, ts, kind }
  // kind: "question" | "suggestion" | "answer" | "revision" | "note"
  messages      String   @default("[]") // JSON.stringify([{...}])
  status        String   @default("open") // open | resolved | expired
  // When the owner suggests an improvement, the agent may produce a new draft
  // (revised summary / risks / action) — stored here for the owner to review
  // before approving the revised version.
  revisedBrief  String?  // JSON { why, risks, ifApproved, ifNotApproved }
  // Inline-message id of the Telegram message carrying the keyboard — we
  // edit this message to update button states after the owner decides.
  telegramMessageId String?
  // Audit
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([approvalId])
  @@index([status])
}

// ─── Phase 29 — GDPR Data Subject Access / Erasure Requests ──────────
// Owner-submitted or user-submitted GDPR requests (access / erasure /
// portability / rectification). Auto-processed for erasure after a
// configurable grace window; manual review for the others.
model DataSubjectRequest {
  id            String   @id @default(cuid())
  // "access" | "erasure" | "portability" | "rectification"
  type          String
  // The user's email or telegram handle — whichever they used to identify
  subject       String   @default("") // email | telegramHandle | phone
  // "pending" | "verified" | "processing" | "completed" | "rejected"
  status        String   @default("pending")
  // JSON: which records will be / were affected, with counts + table names
  affectedRecords  String  @default("{}") // JSON { table: count }
  // Erasure only: ISO timestamp when the row can be auto-purged
  scheduledPurgeAt  DateTime?
  // Audit
  createdAt     DateTime @default(now())
  completedAt   DateTime?
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([subject])
}

// ─── Phase 29 — Comprehensive Audit Log ──────────────────────────────
// Append-only audit trail with user attribution. Every mutating API call
// (POST / PATCH / DELETE) on a sensitive resource (Approval, Contract,
// Payment, Personnel, Credential) writes one row here. Used by the
// compliance auditor (RULE-51) + the new audit-log dashboard.
model AuditLogEntry {
  id            String   @id @default(cuid())
  // Who performed the action: "owner" | agentId | userId | "system"
  actor         String
  actorRole     String   @default("user") // owner | admin | agent | system | user
  // What they did: "create" | "update" | "delete" | "approve" | "deny" | "sign" | "send" | "export"
  action        String
  // Which resource: "Approval" | "Contract" | "Payment" | "Credential" | ...
  resource      String
  resourceId    String   @default("")
  // JSON snapshot of the resource before / after (best-effort, redacted)
  before        String?  // JSON
  after         String?  // JSON
  // Where it happened: HTTP route, Telegram command, cron job name
  source        String   @default("api") // api | telegram | cron | system
  // IP / user agent / chat id (whichever is applicable)
  context       String   @default("{}") // JSON { ip?, userAgent?, chatId? }
  // Audit
  createdAt     DateTime @default(now())

  @@index([actor])
  @@index([resource])
  @@index([action])
  @@index([createdAt])
}

// ─── Phase 30 — E-Signature Event Log ────────────────────────────────
// Append-only log of every webhook event received from an e-signature
// provider (DocuSign / HelloSign / mock). Used for audit trail + for
// re-driving missed events. One row per inbound webhook.
model EsignEvent {
  id              String   @id @default(cuid())
  // Provider + envelope reference
  provider        String   // "docusign" | "hellosign" | "mock"
  envelopeId      String   // provider's envelope ID (matched to Contract.envelopeId)
  eventType       String   // "envelope.sent" | "envelope.delivered" | "envelope.completed" | "envelope.declined" | "envelope.voided"
  // Raw payload (redacted — provider tokens / PII are stripped)
  payloadJson     String   // JSON.stringify(providerEvent)
  // Verification
  signatureValid  Boolean  @default(true) // false if webhook signature check failed
  verificationError String @default("")
  // Idempotency: providers send the same event multiple times. We dedupe
  // by (provider, envelopeId, eventType, eventTimestamp).
  eventTimestamp  DateTime // provider-reported timestamp
  // Processing
  processed       Boolean  @default(false) // true once we've updated Contract.esignStatus
  processedAt     DateTime?
  // Linkage
  contractId      String?  // matched Contract.id (null if envelope not found)
  // Audit
  receivedAt      DateTime @default(now())

  @@index([provider, envelopeId])
  @@index([eventType])
  @@index([contractId])
  @@index([receivedAt])
}

// ─── Phase 30 — Stripe Reconciliation ───────────────────────────────
// One row per Stripe Balance Transaction fetched by the daily
// reconciliation cron. Matched against internal RevenueEvent + LedgerEntry
// records. Discrepancies fire SystemAlert + Telegram owner notification.
model StripeReconciliation {
  id              String   @id @default(cuid())
  // Stripe-side reference
  balanceTransactionId String @unique // Stripe's `txn_xxx` ID
  stripeCreatedAt DateTime // Stripe's created timestamp
  amountCents     Int      // negative = refund, positive = charge
  currency        String   @default("usd")
  feeCents        Int      @default(0) // Stripe processing fee
  netCents        Int      @default(0) // amount - fee
  // Type: charge | refund | payout | adjustment | application_fee
  type            String
  description     String   @default("")
  // Internal matching
  matchedRevenueEventId  String?  // FK to RevenueEvent.id
  matchedLedgerEntryId   String?  // FK to LedgerEntry.id
  matchedServiceOrderId  String?  // FK to ServiceOrder.id
  // Reconciliation status
  status          String   @default("pending") // pending | matched | discrepancy | ignored
  discrepancyReason String @default("") // "no-matching-revenue-event" | "amount-mismatch" | "duplicate"
  // Audit
  reconciledAt    DateTime?
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([stripeCreatedAt])
  @@index([matchedServiceOrderId])
}

// ─── Phase 30 — Tax Calculation ─────────────────────────────────────
// One row per tax calculation (from Stripe Tax API or our static
// fallback). Linked to Contract + ServiceOrder. Stored separately so
// we can re-calculate + audit past calculations.
model TaxCalculation {
  id              String   @id @default(cuid())
  // Source: stripe-tax | static-fallback | manual
  source          String   @default("static-fallback")
  // Input
  subtotalCents   Int      @default(0) // pre-tax amount
  currency        String   @default("USD")
  customerCountry String   @default("") // ISO country code
  customerState   String   @default("") // ISO state/region code
  customerZip     String   @default("")
  // Output
  taxAmountCents  Int      @default(0)
  taxRate         Float    @default(0) // decimal, e.g. 0.0825
  taxJurisdiction String   @default("") // "US-CA" | "EU-DE" | "IN-MH"
  // Stripe-side reference (if source = stripe-tax)
  stripeCalculationId String @default("") // Stripe's `taxcalc_xxx` ID
  stripeTaxCode        String @default("") // e.g. "txcd_10000000" (general taxable)
  // Linkage
  contractId      String?  // FK to Contract.id
  serviceOrderId  String?  // FK to ServiceOrder.id
  // Audit
  calculatedAt    DateTime @default(now())

  @@index([source])
  @@index([contractId])
  @@index([serviceOrderId])
  @@index([calculatedAt])
}

// ─── Phase 30 — Memory Watchdog Snapshot ───────────────────────────
// One row per memory sample taken by the background watchdog. Used to
// detect memory leaks over time (linear growth = leak) + trigger
// alerts when thresholds are exceeded. The cron `memory-watchdog`
// writes a row every 5 minutes; the cron `daily-soak-analysis`
// analyzes the day's samples + alerts on leaks.
//
// NOTE: values are stored as MEGABYTES (Int) rather than BYTES because
// SQLite's Int column is 32-bit signed (max ~2.1 GB). Storing in MB
// lets us represent up to 2 TB of memory. The lib/memory-watchdog.ts
// module converts bytes → MB before persisting.
model MemorySnapshot {
  id              String   @id @default(cuid())
  // Process info
  pid             Int
  uptimeSeconds   Int
  // Memory (in MEGABYTES — Int column is 32-bit, max 2 TB)
  rssMB           Int      // resident set size
  heapUsedMB      Int      // V8 heap used
  heapTotalMB     Int      // V8 heap total
  externalMB      Int      // C++ objects bound to V8
  arrayBufferMB   Int      @default(0) // ArrayBuffers
  // System info (in MEGABYTES)
  systemTotalMB   Int
  systemFreeMB    Int
  // Computed
  rssPercent      Float    // rssBytes / thresholdBytes * 100
  // Alert level: "ok" | "warn" | "critical"
  alertLevel      String   @default("ok")
  // Optional: top 5 modules by memory (when leak detected)
  topModulesJson  String   @default("[]") // [{name, sizeMB}]
  // Audit
  sampledAt       DateTime @default(now())

  @@index([alertLevel])
  @@index([sampledAt])
}
