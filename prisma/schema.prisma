// ─── Service Orders (v32 — Crypto payments, owner approval) ────────
model ServiceOrder {
  id              String   @id @default(cuid())
  serviceId       String                                    // catalog service ID
  serviceName     String                                    // denormalized for audit
  spec            String                                    // customer's free-text spec
  priceCents      Int                                       // price at time of purchase
  currency        String   @default("usd")
  status          String   @default("pending_payment")      // pending_payment | owner_approved | building | delivered | failed | refunded
  // ── Crypto payment fields (replaces Stripe) ──
  cryptoNetwork   String   @default("BTC")                  // BTC | ETH | SOL | USDT | USDC | UPI | Stripe | PayPal | Razorpay | Bank
  walletAddress   String?                                  // owner's wallet address for payment (or null for UPI/Stripe)
  cryptoTxHash    String?                                  // customer-provided transaction hash (optional verification)
  ownerApproved   Boolean  @default(false)                  // owner manually confirmed payment receipt
  ownerApprovedAt DateTime?
  // ── Customer info ──
  customerEmail   String?
  customerName    String?
  // ── Build output ──
  deliverablePath String?                                  // path to the zip file
  fileCount       Int      @default(0)
  files           String   @default("[]")                  // JSON array of filenames
  buildLog        String?                                  // error/info from the builder
  buildProvider   String?                                  // which LLM provider built it
  buildModel      String?                                  // which model
  buildLatencyMs  Int?
  // ── Notification tracking ──
  customerNotified Boolean @default(false)                  // web push / email sent
  notificationLog  String?                                  // JSON log of notification attempts
  // ── Metadata ──
  createdAt       DateTime @default(now())
  deliveredAt     DateTime?
  updatedAt       DateTime @updatedAt
  @@index([serviceId])
  @@index([status])
  @@index([customerEmail])
  @@index([ownerApproved])
  @@index([cryptoTxHash])

  // ── v44 fixes: confirmation tracking + UPI support ──
  cryptoConfirmations Int?                                     // on-chain confirmations counted
  paymentDetectedAt   DateTime?                                // first time we saw the tx
  paymentConfirmedAt  DateTime?                                // when MIN_CONFIRMATIONS reached
  paymentCheckCount   Int      @default(0)                     // how many cron ticks we've checked
  // ── UPI payment fields (v44 — Indian UPI/QR support) ──
  upiVpa              String?                                  // owner VPA (e.g. owner@upi)
  upiUtr              String?                                  // customer-provided UTR (transaction ref)
  upiAmountInr        Float?                                   // INR amount expected
  upiQrImageB64       String?                                  // base64 QR image (stored at checkout time)
  upiApprovedAt       DateTime?                                // when owner approved the UPI payment
  upiRejectedReason   String?                                  // if rejected, why
}

// ─── Notification Log (v40 — fallback when email/push fails) ────────
// Every notification attempt (email, push, refund notice) is recorded
// here so the owner can see delivery status in the dashboard even if
// the external provider is down. The `status` field tracks the outcome:
//   sent | failed | pending
// `channel` tracks the mechanism: email | push | internal
model NotificationLog {
  id          String   @id @default(cuid())
  channel     String   // email | push | internal
  recipient   String   // email address or push endpoint
  subject     String
  body        String   // full message body (for audit)
  status      String   @default("pending") // sent | failed | pending
  provider    String?  // resend | web-push | gmail-vision | internal
  error       String?  // error message if failed
  metadata    String   @default("{}") // JSON: { orderId, userId, ... }
  createdAt   DateTime @default(now())

  @@index([channel])
  @@index([status])
  @@index([recipient])
  @@index([createdAt])
}

// ─── Web Push Subscriptions (v45 — persistent push notification endpoints) ──
// Stores browser push subscription endpoints so notifications survive server restarts.
// The owner's browser subscribes via /api/notifications/subscribe (POST with subscription JSON).
// sendWebPush() in notifications.ts reads from this table.
model WebPushSubscription {
  id          String   @id @default(cuid())
  endpoint    String   @unique              // the browser's push endpoint URL
  p256dh      String                        // client public key
  auth        String                        // client auth secret
  userId      String?                       // optional: linked user
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ─── Error Log (v42 — $0 error tracking, Sentry-ready) ─────────────
// Captures unhandled promise rejections, uncaught exceptions, and
// error.tsx boundary errors. If SENTRY_DSN is set, also forwards to Sentry.
model ErrorLog {
  id          String   @id @default(cuid())
  message     String   // error message
  stack       String?  // stack trace
  digest      String?  // Next.js error digest (from error.tsx)
  url         String?  // request URL (if available)
  userAgent   String?  // browser UA (for client errors)
  severity    String   @default("error") // error | warning | fatal
  context     String   @default("{}") // JSON: { userId, route, ... }
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
}

// v56: PromptVersion — tracks prompt improvements over time
model PromptVersion {
  id          String   @id @default(cuid())
  serviceType String
  version     Int
  content     String
  source      String   @default("manual")
  successRate Float?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdBy   String?
  @@unique([serviceType, version])
  @@index([serviceType])
  @@index([isActive])
}

