// v71 Phase 21: Autonomous Lead Hunting — Lead model
// Stores leads discovered by the social-scout module + their qualification
// verdicts from the Scout/Risk/Sales multi-agent debate.
model Lead {
  id            String   @id @default(cuid())
  // Source
  source        String   @default("social-scout") // social-scout | manual | inbound | referral
  platform      String   @default("") // twitter | linkedin | reddit | website | email
  // Identity
  username      String   @default("") // social handle or email
  displayName   String   @default("")
  profileUrl    String   @default("")
  website       String?  // optional — only if the lead has one
  // Buying signal
  postContent   String   @default("") // the social post that triggered the match
  postUrl       String   @default("")
  postedAt      DateTime? // when the buying signal was posted
  // Engagement metrics (indicates seriousness)
  likes         Int      @default(0)
  replies       Int      @default(0)
  reposts       Int      @default(0)
  followerCount Int      @default(0)
  accountAgeDays Int     @default(0) // 0 = unknown; low values = suspicious
  // Brand profile (extracted by profile-extractor.ts)
  brandProfileJson String @default("{}") // LeadBrandProfile JSON
  // Service matches (from service-matcher.ts)
  serviceMatchesJson String @default("[]") // ServiceMatch[] JSON
  topMatchedService String @default("") // denormalized for quick dashboard queries
  // Qualification debate result (from qualification-debate.ts)
  qualificationVerdict String @default("pending") // pending | pursue | investigate | skip
  qualificationScore Int @default(0) // 0-100 confidence
  qualificationReasoning String @default("")
  // Outreach tracking
  outreachStatus String @default("none") // none | sent | replied | converted | rejected
  outreachSentAt DateTime?
  outreachChannel String @default("") // whatsapp | email | social-reply
  // Audit trail
  discoveredAt  DateTime @default(now())
  qualifiedAt   DateTime?
  contactedAt   DateTime?
  updatedAt     DateTime @updatedAt

  @@index([source])
  @@index([platform])
  @@index([qualificationVerdict])
  @@index([outreachStatus])
  @@index([discoveredAt])
}

// v72 Phase 22 (RULE-70): Proactive Lead Generation — new models
// Stores businesses without websites discovered on Google Maps, owner-uploaded
// contact lists, free-offer redemptions, ARIA's own social media accounts +
// posts, and per-category approval patterns.

model GoogleMapsBusiness {
  id              String   @id @default(cuid())
  // Identity
  businessName    String
  address         String   @default("")
  city            String   @default("")
  region          String   @default("")
  country         String   @default("")
  latitude        Float?   @default(0)
  longitude       Float?   @default(0)
  // Contact (scraped from Google Maps)
  phone           String?  // null = no phone listed
  website         String?  // null = NO WEBSITE (this is the target!)
  googleMapsUrl   String   @default("")
  googlePlaceId   String?  @unique
  // Classification
  category        String   @default("") // e.g. "restaurant", "salon", "plumber"
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  // Qualification
  hasWebsite      Boolean  @default(false) // denormalized for fast filtering
  matchedServiceCategory String @default("landing-page")
  qualificationVerdict String @default("pending") // pending | pursue | investigate | skip
  qualificationScore Int  @default(0)
  // Outreach tracking
  outreachStatus  String   @default("none") // none | sent | replied | converted | rejected
  outreachChannel String   @default("") // whatsapp | email | call | social-reply
  outreachSentAt  DateTime?
  // Lead linkage (optional — link to Lead table when promoted)
  leadId          String?  // FK to Lead.id (nullable for not-yet-promoted)
  // Audit
  discoveredAt    DateTime @default(now())
  contactedAt     DateTime?
  updatedAt       DateTime @updatedAt

  @@index([hasWebsite])
  @@index([category])
  @@index([qualificationVerdict])
  @@index([outreachStatus])
  @@index([city])
}

