# ARIA Mission Control — Environment Variables (v57 PRODUCTION)
#
# This is the COMPLETE environment template. Copy to `.env` and fill in
# the values you actually use. Variables are hot-reloaded every 5s by
# env-loader.ts — no restart needed for changes.
#
# The /dashboard/settings UI lets the owner edit most of these from the
# browser. The fields marked [UI] can be edited via the UI. Others must
# be set in this file (or environment variables on the host).
#
# ───────────────────────────────────────────────────────────────────
# CRITICAL (app won't start without these)
# ───────────────────────────────────────────────────────────────────
# SQLite dev | postgresql://user:pass@host/db prod
# v61 Phase 5: For cloud deployment, use Supabase (managed PostgreSQL).
#   1. Create a free project at https://supabase.com (500MB DB + 50K MAU free tier)
#   2. Copy the connection string from Settings → Database → Connection string
#   3. Set: DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
#   4. Run: bunx prisma db push --accept-data-loss (applies schema to Supabase)
#   5. Run: bunx prisma generate (regenerates the client for Postgres)
# Supabase gives you: automatic daily backups, real-time subscriptions,
# REST/GraphQL API, row-level security, and a dashboard. The app's
# Prisma schema works with both SQLite + Postgres without changes.
DATABASE_URL="file:./db/custom.db"
NEXTAUTH_SECRET="run: openssl rand -base64 32"
# public URL for callbacks
NEXTAUTH_URL="http://localhost:3000"
ARIA_OWNER_EMAIL="owner@yourcompany.com"

# ───────────────────────────────────────────────────────────────────
# AI / LLM PROVIDERS (editable via /dashboard/settings UI)
# ───────────────────────────────────────────────────────────────────
# Z-AI is the default + free tier
ZAI_API_KEY=""
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
# Groq — FREE at https://console.groq.com (30 RPM, 14400/day)
GROQ_API_KEY=""
# NVIDIA NIM — FREE at https://build.nvidia.com (1000 req/day)
NVIDIA_API_KEY=""
# OpenAI (optional, paid) — for higher quality if needed
OPENAI_API_KEY=""
# Anthropic Claude (optional, paid)
ANTHROPIC_API_KEY=""
# Google Gemini (optional, free tier available)
GEMINI_API_KEY=""

# Local LLM (cheaper than cloud) — install Ollama from https://ollama.com
OLLAMA_HOST="http://127.0.0.1:11434"
WORKFORCE_MODEL_STRONG="qwen2.5:14b"
WORKFORCE_MODEL_BALANCED="qwen2.5:7b"
WORKFORCE_MODEL_FAST="qwen2.5:3b"

# Per-provider RPM limits
ARIA_LLM_RPM_ZAI="5"
ARIA_LLM_RPM_GROQ="30"
ARIA_LLM_RPM_NVIDIA="20"
ARIA_LLM_RPM_OLLAMA="60"
ARIA_LLM_RPM_OPENAI="50"
ARIA_LLM_RPM_ANTHROPIC="40"
ARIA_LLM_RPM_GEMINI="30"

ARIA_PREFER_LOCAL_LLM="0"
LLM_DAILY_BUDGET_USD="1.00"

# ───────────────────────────────────────────────────────────────────
# REAL PHONE CALLS  [editable via /dashboard/settings UI → Telephony]
# ───────────────────────────────────────────────────────────────────
# ARIA supports 4 telephony providers. Configure at least one.
#
# PROVIDER 1: FreeSWITCH (native SIP server, $0/mo after install)
#   Install: https://freeswitch.org/confluence/
#   Buy SIP trunk: VoIP.ms ($0.85/mo + $0.005/min US/CA)
#   Configure: dialplan + SIP gateway → PSTN
FREESWITCH_ESL_HOST="127.0.0.1"
FREESWITCH_ESL_PORT="8021"
FREESWITCH_ESL_PASSWORD="ClueCon"
FREESWITCH_SIP_GATEWAY="local-pstn"
FREESWITCH_FROM_NUMBER=""

# ───────────────────────────────────────────────────────────────────
# v69 Phase 19 BLOCKER 6: VOICE / DUAL-TTS SERVICE VARIABLES
# (Required by services/pipecat/main.py + docker-compose.yml)
# ───────────────────────────────────────────────────────────────────
# Piper TTS — instant filler voice (<100ms latency, RULE-59)
# Runs as a Docker container (rhasspy/piper:latest) on port 5000.
PIPER_URL="http://localhost:5000"
#
# Fish Audio — premium cloned voice (RULE-54). Mode:
#   "api"       → cloud Fish Audio API (works on any arch, requires API key)
#   "local"     → self-hosted fish-speech (requires GPU)
#   "cosyvoice" → CosyVoice CPU mode (slower, but no GPU needed)
# v69 Phase 19 BLOCKER 8: if "api"/"local" import fails OR arch is ARM64
# without GPU, the Pipecat service auto-degrades to Piper-only — no crash.
FISH_AUDIO_API_KEY=""
FISH_AUDIO_MODE="api"
#
# Latency threshold (ms) — if Fish Audio response exceeds this, the
# Pipecat service falls back to Piper for the brain response (RULE-59).
LATENCY_THRESHOLD="800"
#
#
# PROVIDER 2: Dograh Cloud Telephony (REST API, no install)
#   Get API key at https://www.dograh.com (India-focused)
DOGRAH_API_KEY=""
DOGRAH_BASE_URL="https://api.dograh.com"
#
# PROVIDER 3: Twilio (most popular, paid, REST API)
#   Get keys at https://www.twilio.com/console ($1/mo number + $0.01/min)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
#
# PROVIDER 4: WebRTC (built-in browser, $0 — for browser-to-browser calls)
# No configuration needed — uses navigator.mediaDevices.getUserMedia
#
# Owner phone for notifications
OWNER_PHONE_NUMBER=""
#
# SAFETY GATE: both must be "true" (literal string) to enable outbound calls.
# This enforces legal consent compliance — DO NOT enable without documented consent.
AI_CALLER_ENABLED=""
AI_CALLER_CONSENT_VERIFIED=""

# ───────────────────────────────────────────────────────────────────
# REAL LEAD GENERATION  [editable via /dashboard/settings UI → Lead Gen]
# ───────────────────────────────────────────────────────────────────
# ARIA's lead-finder.ts uses Z-AI web_search by default (FREE).
# For higher-quality B2B leads, configure one of these enrichment APIs:
#
# Apollo.io — 10 free credits/mo, https://app.apollo.io/settings/integrations
APOLLO_API_KEY=""
# Hunter.io — 50 free searches/mo, https://hunter.io/api-keys
HUNTER_API_KEY=""
# Snov.io — 50 free credits/mo, https://app.snov.io
SNOV_API_KEY=""
# Clearbit Enrichment — paid, https://clearbit.com
CLEARBIT_API_KEY=""
# ZoomInfo — paid enterprise, https://zoominfo.com
ZOOMINFO_API_KEY=""

# Outreach daily send limit (warmup protection).
ARIA_OUTREACH_DAILY_LIMIT="10"

# Search providers for lead discovery (Z-AI is built-in)
# zai | apollo | hunter | snov | clearbit | zoominfo
ARIA_SEARCH_PROVIDER="zai"

# ───────────────────────────────────────────────────────────────────
# EARNING / PAYMENT METHODS  [editable via /dashboard/settings UI → Payments]
# ───────────────────────────────────────────────────────────────────
# METHOD 1: Crypto (BTC/ETH/SOL/USDT/USDC) — $0 fees, works out of the box
CRYPTO_WALLET_ADDRESS=""
CRYPTO_NETWORK="BTC"
# Etherscan — FREE at https://etherscan.io/register (5 req/s, 100K/day)
ETHERSCAN_API_KEY=""

# METHOD 2: UPI (India-focused, instant settlement)
# VPA is set via /api/settings/upi API (UI-driven)
# QR image uploaded via /api/settings/upi (UI-driven)
# Static fallbacks if UI is not used:
ARIA_UPI_VPA=""
ARIA_UPI_PAYEE_NAME=""

# METHOD 3: Stripe Card Payments (cards, Apple/Google Pay)
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# METHOD 4: PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# sandbox | live
PAYPAL_MODE="sandbox"

# METHOD 5: Razorpay (India cards/UPI/netbanking)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# METHOD 6: Bank Transfer (manual confirm by owner)
ARIA_BANK_NAME=""
ARIA_BANK_ACCOUNT_NAME=""
ARIA_BANK_ACCOUNT_NUMBER=""
ARIA_BANK_IFSC=""
ARIA_BANK_SWIFT=""

# ───────────────────────────────────────────────────────────────────
# EMAIL / OUTREACH  [editable via /dashboard/settings UI → Email]
# ───────────────────────────────────────────────────────────────────
# Resend (free 3,000 emails/month at https://resend.com)
RESEND_API_KEY=""
# MUST be a verified sender domain for outreach
RESEND_FROM_EMAIL="founder@yourdomain.com"
RESEND_WEBHOOK_SECRET=""
# Owner info for CAN-SPAM compliance (REQUIRED if RESEND_API_KEY is set)
ARIA_SENDER_ADDRESS="123 Main St, City, State ZIP, Country"
BOOKING_URL="https://cal.com/aria-mission-control"

# ───────────────────────────────────────────────────────────────────
# WHATSAPP BUSINESS CLOUD API  [editable via /dashboard/settings UI → WhatsApp]
# ───────────────────────────────────────────────────────────────────
# Get a WhatsApp Business account: https://business.whatsapp.com/
# Create an app: https://developers.facebook.com/apps/
# Phone number ID + access token from App Dashboard
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# for webhook signature verification
WHATSAPP_APP_SECRET=""
# any random string you choose for webhook verification
WHATSAPP_VERIFY_TOKEN=""

# ───────────────────────────────────────────────────────────────────
# TELEGRAM NOTIFICATIONS  [editable via /dashboard/settings UI → Telegram]
# ───────────────────────────────────────────────────────────────────
# Create bot via @BotFather on Telegram.
#
# v59 (Notion "AI Company Map" Autonomy Tags):
#   REQUIRED for any workflow/skill tagged HUMAN_ASSISTED. The conductor-router
#   (src/lib/conductor/router.ts) creates an Approval row + sends a Telegram
#   brief to TELEGRAM_CHAT_ID before executing the workflow. The owner then
#   approves via /approve <id> (Telegram) or the dashboard.
#
#   If these are unset, HUMAN_ASSISTED workflows still create the Approval row
#   (visible in the dashboard) but no Telegram brief is sent — the owner must
#   poll the dashboard manually.
#
#   How to get TELEGRAM_CHAT_ID:
#     1. Message @userinfobot on Telegram → it replies with your chat id.
#     2. Or: add @get_id_bot to your chat → it posts the chat id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ───────────────────────────────────────────────────────────────────
# WEB PUSH NOTIFICATIONS (VAPID keys)
# ───────────────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:owner@yourdomain.com"

# ───────────────────────────────────────────────────────────────────
# SECURITY / ENCRYPTION  [DO NOT use defaults in prod]
# ───────────────────────────────────────────────────────────────────
# Credential Vault master key (AES-256-GCM) — generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=""

# ───────────────────────────────────────────────────────────────────
# REALTIME SIDECAR (OPTIONAL — SSE works without it)
# ───────────────────────────────────────────────────────────────────
ARIA_REALTIME_KEY=""

# ───────────────────────────────────────────────────────────────────
# TTS (server-side text-to-speech)
# ───────────────────────────────────────────────────────────────────
ZAI_TTS_ENABLED=""

# ───────────────────────────────────────────────────────────────────
# AUTH + RBAC
# ───────────────────────────────────────────────────────────────────
# "single-operator" for self-host (dev bypass allowed), "multi-tenant" for production
JARVIS_AUTH_MODE="single-operator"
# MUST be 0 in production
JARVIS_DEV_BYPASS_AUTH="0"
JARVIS_MULTI_TENANT="false"

# ───────────────────────────────────────────────────────────────────
# SAFETY / EXECUTION KILL-SWITCHES  [editable via /dashboard/settings UI → Flags]
# ───────────────────────────────────────────────────────────────────
ALLOW_CODE_EXEC="false"
ALLOW_TERMINAL_EXEC="false"
UI_HEALER_AUTO_APPROVE="false"
RATE_LIMIT_DISABLED="false"

# ─── v61 Phase 1: SIMULATION + FREE-ONLY MODES ──────────────────────
# When false (default), the simulation engine does NOT fabricate revenue,
# deals, messages, or memories. Only real work (crons, API routes) produces
# data. Set to "true" only for first-paint demos / sales previews.
ARIA_SIMULATION_MODE="false"

# When "true" (recommended default), the LLM router completely skips paid /
# freemium providers (Z-AI, Groq, NVIDIA) and forces routing to local
# Ollama only. Set to "false" to enable the full 5-provider failover chain.
# Requires Ollama running locally with at least one model pulled
# (e.g. `ollama pull qwen2.5:7b`).
FREE_ONLY_MODE="true"

# When "true" + FREE_ONLY_MODE, the router also uses Ollama for TTS / image
# generation instead of paid cloud services. Leave false if you want to keep
# Z-AI TTS while still using Ollama for chat.
FREE_ONLY_TTS="false"

# ─── v61 Phase 2: OPERATIONAL DISCIPLINE ────────────────────────────
# Owner timezone — used by the business-hours guard to defer owner/customer
# interactions to 9 AM - 6 PM in the owner's timezone. Critical alerts bypass.
OWNER_TIMEZONE="Asia/Kolkata"

# Deployment environment — when "oracle-free-tier", the LLM router uses a
# memory-conservative routing profile (lightweight 3b/1.5b models first,
# no-login scrapers next, throttled APIs skipped).
DEPLOYMENT_ENV="oracle-free-tier"

# Business hours window (24-hour format). Default 9 AM - 6 PM.
BUSINESS_HOURS_START="9"
BUSINESS_HOURS_END="18"

# ───────────────────────────────────────────────────────────────────
# DEV / PROD FLAGS
# ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
# trace | debug | info | warn | error
ARIA_LOG_LEVEL="info"
# sales tax % for invoices
ARIA_TAX_RATE="0"

# ════════════════════════════════════════════════════════════════════
# v76.2 ADDITIONS — Missing vars from user logs + reference configs
# ════════════════════════════════════════════════════════════════════

# ─── NETWORK ACCESS (v76.2 fix for LAN access) ─────────────────────
# Set this to your machine's LAN IP so other devices can access the app.
HOST="0.0.0.0"
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ARIA_PUBLIC_URL="http://localhost:3000"
# For LAN access, set: ARIA_PUBLIC_URL="http://192.168.29.209:3000"

# ─── LLM ROUTING CONFIGURATION ─────────────────────────────────────
ARIA_PREFER_LOCAL_LLM="1"
LLM_DAILY_BUDGET_USD="1.00"
LLM_FALLBACK_CHAIN="ollama,groq,nvidia,zai"
LLM_TIMEOUT_MS="30000"
LLM_MAX_RETRIES="3"

# ─── ADDITIONAL LLM MODELS (from user's Ollama list) ─────────────
WORKFORCE_MODEL_STRONG="qwen2.5-coder:7b"
WORKFORCE_MODEL_BALANCED="llama3.2:3b"
WORKFORCE_MODEL_FAST="qwen2.5-coder:1.5b"
WORKFLOW_PROPOSER_MODEL="llama3.2:3b"
VISION_MODEL="qwen2.5vl:3b"
EMBEDDING_MODEL="nomic-embed-text"

# ─── LEAD GENERATION & ENRICHMENT (Optional APIs) ─────────────────
APOLLO_API_KEY=""
HUNTER_API_KEY=""
SNOV_API_KEY=""
CLEARBIT_API_KEY=""
ZOOMINFO_API_KEY=""
ARIA_OUTREACH_DAILY_LIMIT="10"
ARIA_SEARCH_PROVIDER="zai"

# ─── ADDITIONAL PAYMENT PROVIDERS ─────────────────────────────────
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_MODE="sandbox"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
ARIA_BANK_NAME=""
ARIA_BANK_ACCOUNT_NAME=""
ARIA_BANK_ACCOUNT_NUMBER=""
ARIA_BANK_IFSC=""
ARIA_BANK_SWIFT=""

# ─── WEB PUSH NOTIFICATIONS ──────────────────────────────────────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:owner@yourdomain.com"

# ─── REALTIME & WEBSOCKETS ────────────────────────────────────────
ARIA_REALTIME_KEY="your-websocket-secret"

# ─── MONITORING & LOGGING ─────────────────────────────────────────
ARIA_LOG_LEVEL="info"
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ─── BUSINESS CONFIGURATION ───────────────────────────────────────
BUSINESS_HOURS_START="9"
BUSINESS_HOURS_END="18"
ARIA_TAX_RATE="0"

# ─── SIMULATION & TESTING ─────────────────────────────────────────
ARIA_SIMULATION_MODE="false"
FREE_ONLY_MODE="true"
FREE_ONLY_TTS="true"

# ─── SAFETY KILL-SWITCHES ─────────────────────────────────────────
ALLOW_CODE_EXEC="false"
ALLOW_TERMINAL_EXEC="false"
UI_HEALER_AUTO_APPROVE="false"
RATE_LIMIT_DISABLED="false"

# ─── AUTH MODE (from v25.8 reference) ────────────────────────────
JARVIS_AUTH_MODE="single-operator"
JARVIS_SINGLE_USER_MODE="true"
JARVIS_MULTI_TENANT="false"
JARVIS_DEV_BYPASS_AUTH="1"
JARVIS_DEV_USER_ID="system"
JARVIS_ALLOWED_ORIGINS="http://127.0.0.1:3000,http://localhost:3000,http://192.168.29.209:3000"
CORS_ORIGINS="http://localhost:3000"
NEXT_PUBLIC_MULTI_TENANT="false"

# ─── INTERNAL SECRETS (from v25.8 reference — generate fresh) ─────
# These are used for inter-service communication + API signing.
ARIA_INTERNAL_SECRET="run: openssl rand -hex 24"
JARVIS_SHARED_KEY="run: openssl rand -hex 32"
JARVIS_KEY_VERSION="1"

# ─── TELEGRAM WEBHOOK (from v25.8 reference) ──────────────────────
TELEGRAM_WEBHOOK_SECRET="run: openssl rand -hex 16"

# ─── BOOKING (from reference) ─────────────────────────────────────
BOOKING_URL="https://cal.com/your-calendar"
